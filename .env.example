# Documentation only. Do not copy an empty password and expect login to work.
# Run: python3 -B scripts/commerce_local_setup.py
# It generates an ignored, mode-600 .env with a random local operator password.
COMMERCE_STAFF_USERNAME=operator
COMMERCE_STAFF_PASSWORD=
# Optional local origin override; do not expose this HTTP demo publicly.
COMMERCE_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Final fictional application only. Choose a local password of at least 16 characters.
# Recommended launcher reads terminal variables, not .env:
# export COMMERCE_DEMO_PASSWORD='fictional-demo-password-only'
# bash scripts/demo.sh start
# For direct `docker compose up`, copy this file to ignored .env and fill the password.
COMMERCE_DEMO_PASSWORD=
COMMERCE_DEMO_MODE=rules
# Direct Compose only; the supported launcher fixes the loopback port to 8133.
COMMERCE_DEMO_PORT=8133
